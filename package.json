{
  "name": "include-graph",
  "displayName": "Include Graph",
  "description": "Include Graph adds a dependency tree for C++ projects to the VS Code side bar. Expand any file to see the headers it includes, then their dependencies, and so on. It helps you understand an unfamiliar codebase quickly and see which files a header change will affect.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "include-graph.refresh",
        "title": "Include Graph: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {"id": "IncludeGraph", "title": "Include Graph", "icon": "resources/icon.svg"}
      ]
    },
    "views": {
      "IncludeGraph": [
        {"id": "includeGraph.tree", "name": "Files"}
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "parse": "tsx ./TRY/try-parser.ts",
    "resolve": "tsx ./TRY/try-resolve-absolute-path.ts",
    "graph": "tsx ./TRY/try-graph.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
